<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer><handlers><remove name="aspNetCore" /></handlers><defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument><staticContent><remove fileExtension=".apk" /><mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" /></staticContent></system.webServer></configuration>
